PANCAKE_ACCESS_TOKEN=replace_me
PANCAKE_BASE_URL=https://pages.fm/api/public_api/v1
PANCAKE_ACCOUNT_BASE_URL=https://pages.fm/api/v1
DATABASE_URL=postgres://crawler:crawler@localhost:15432/crawler?sslmode=disable
REDIS_URL=redis://localhost:16379/0
CRON_SCHEDULE=0 21 * * *
CRON_TIMEZONE=Asia/Ho_Chi_Minh
WORKER_POOL_SIZE=8
RATE_LIMIT_PER_PAGE_RPS=5
RATE_LIMIT_PER_PAGE_BURST=5
TOKEN_TTL=3600s
HTTP_ADDR=:18080
LOG_LEVEL=info

# Host ports publish ra máy (tránh dùng port mặc định để không xung đột)
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
CRAWLER_HOST_PORT=18080
WEB_HOST_PORT=18081

# Read API
JWT_SECRET=change-me-in-prod
JWT_TTL=12h
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=change-me
# CORS_ORIGIN: dùng "*" cho dev; production PHẢI đặt origin cụ thể của FE (vd https://app.cong-ty.vn)
CORS_ORIGIN=*
